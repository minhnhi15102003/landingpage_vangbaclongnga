# No public/default admin password. Run npm.cmd run admin:setup locally.
ADMIN_USERNAME=
# In .env.local only: escape every $ as \$; in Vercel enter the plain bcrypt hash.
ADMIN_PASSWORD_HASH=
# At least 32 random bytes encoded as base64url; generated by admin:setup.
AUTH_SECRET=
# Production: exact https origin, no trailing slash. Leave empty for local dev.
ADMIN_ORIGIN=

# Local: read/write on this computer. Vercel: published site only until github is configured.
CONTENT_STORAGE=local
# Separate, private repository initialized with a README, NOT the source-code repo.
CONTENT_GITHUB_OWNER=
CONTENT_GITHUB_REPO=
CONTENT_GITHUB_BRANCH=main
# Fine-grained token: only that private repo, Contents read/write.
CONTENT_GITHUB_TOKEN=
